# Copy to .env only for local development and keep that file private.
HACKMD_API_TOKEN=replace-with-a-dedicated-hackmd-token
# HACKMD_API_URL=https://api.hackmd.io/v1
# HACKMD_MCP_STATE_DIR=/absolute/private/path/to/hackmd-mcp-state
# Confine the local sync tools to one tree. Unset means any absolute path is
# accepted, which is the historical behavior.
# HACKMD_MCP_WORKSPACE_ROOT=/absolute/path/to/your/notes
